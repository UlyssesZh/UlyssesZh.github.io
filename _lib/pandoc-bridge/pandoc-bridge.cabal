cabal-version: 3.0
name:          pandoc-bridge
version:       0.1.0.0
license:       MIT
author:        UlyssesZhan
build-type:    Simple

foreign-library pandoc_bridge
  type:             native-shared
  options:          standalone
  other-modules:    PandocBridge
  hs-source-dirs:   src
  build-depends:
      base              >=4.18 && <5
    , aeson             >=2.0  && <2.3
    , bytestring        >=0.11 && <0.13
    , containers        >=0.6  && <0.8
    , msgpack           >=1.0  && <1.1
    , pandoc            >=3.8  && <3.10
    , pandoc-crossref   >=0.3.23 && <0.3.25
    , pandoc-types      >=1.23 && <1.24
    , scientific        >=0.3  && <0.4
    , text              >=2.0  && <2.2
    , vector            >=0.12 && <0.14
  default-language: Haskell2010
  default-extensions:
      ForeignFunctionInterface
      LambdaCase
      OverloadedStrings
      RecordWildCards
      ScopedTypeVariables
  ghc-options:
      -Wall
      -flink-rts
      -threaded
      -dynamic
      -fPIC
